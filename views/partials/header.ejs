<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Dynamic page title passed from routes/index.js -->
  <title><%= title %> | Musawer Beissed</title>
  <!-- Bootstrap 5 CSS Framework -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Custom CSS overrides served from public/stylesheets/style.css -->
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <!-- Shared Navigation Bar across all EJS views -->
  <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <i class="fas fa-shield-halved me-2 text-accent"></i>Musawer Beissed
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link <%= title === 'Home' ? 'active text-accent' : '' %>" href="/">
              <i class="fas fa-home me-1"></i> Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= title === 'About Me' ? 'active text-accent' : '' %>" href="/about">
              <i class="fas fa-user me-1"></i> About Me
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= title === 'Projects' ? 'active text-accent' : '' %>" href="/projects">
              <i class="fas fa-diagram-project me-1"></i> Projects
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= title === 'Contact Me' ? 'active text-accent' : '' %>" href="/contact">
              <i class="fas fa-envelope me-1"></i> Contact Me
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>